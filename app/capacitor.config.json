{
  "appId": "com.wangmiaotw.app",
  "appName": "汪喵回家",
  "webDir": "www",
  "backgroundColor": "#FFF6F8",
  "loggingBehavior": "none",
  "appendUserAgent": "WangMiaoApp",
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#FFD3DF",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "launchFadeOutDuration": 180
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_paw",
      "iconColor": "#CC3F1E"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
